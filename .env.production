# Production Environment Configuration
# Used when running: npm run build

# WebSocket URL for production (Fly.io backend)
REACT_APP_WS_URL=https://ludo-backend.fly.dev/game

# Environment identifier
REACT_APP_ENV=production

# pixi-filters ships .map files whose "sources" point at .ts files not
# included in the npm package - CRA's source-map-loader can't resolve
# them and (with CI=1, which Vercel sets by default) that warning becomes
# a hard build failure. Disabling sourcemap generation for production
# builds only sidesteps it; `npm start` still gets sourcemaps for local work.
GENERATE_SOURCEMAP=false
